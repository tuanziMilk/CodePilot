# Copy this file to .env and enter your own non-committed API key.
LLM_PROVIDER=deepseek
LLM_MODEL=REPLACE_WITH_YOUR_DEEPSEEK_MODEL
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_REQUEST_RETRIES=2

# Agent runtime boundaries
GIT_BASH_PATH=E:\\Git\\bin\\bash.exe
AGENT_MAX_STEPS=12
AGENT_MAX_RETRIES=1
TOOL_POLICY_VERSION=mvp-v1
PROMPT_VERSION=mvp-v1
COMMAND_TIMEOUT_SECONDS=60
